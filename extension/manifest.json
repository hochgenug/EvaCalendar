{
  "manifest_version": 3,
  "key": "",
  "name": "EVA → Google Calendar",
  "version": "1.0.0",
  "description": "Synchronise automatiquement tes sessions EVA (eva.gg) dans Google Calendar.",
  "permissions": ["alarms", "storage", "notifications", "identity", "tabs", "scripting"],
  "host_permissions": ["https://app.eva.gg/*", "https://api.eva.gg/*", "https://www.googleapis.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://app.eva.gg/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "EVA Sync" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
